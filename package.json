{
  "name": "canonloom",
  "version": "0.1.0",
  "description": "A local-first continuity engine for novelists and AI roleplay writers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atheniaandara-dot/CanonLoom.git"
  },
  "homepage": "https://github.com/atheniaandara-dot/CanonLoom#readme",
  "bugs": {
    "url": "https://github.com/atheniaandara-dot/CanonLoom/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": "./src/index.mjs",
  "bin": {
    "canonloom": "./bin/canonloom.mjs"
  },
  "files": [
    "src",
    "bin",
    "schemas",
    "examples",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "check": "node scripts/check.mjs",
    "release:pack": "node scripts/package.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "continuity",
    "canon",
    "writing",
    "novel",
    "roleplay",
    "offline",
    "story-bible"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "ajv": "8.17.1",
    "jsdom": "26.1.0",
    "prettier": "3.5.3"
  }
}
